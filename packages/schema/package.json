{
  "name": "@scenefile/schema",
  "version": "0.3.0",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node ../../scripts/fix-dts.mjs",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "@scenefile/scenes": "workspace:*",
    "zod": "^4"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "video",
    "mp4",
    "llm",
    "agents",
    "mcp",
    "json",
    "ffmpeg",
    "scenefile"
  ],
  "author": "Xusniddin Qalandarov",
  "publishConfig": {
    "access": "public"
  },
  "description": "The scenefile format: schema, repair and diagnostics.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xusniddin-devv/scenefile.git",
    "directory": "packages/schema"
  },
  "homepage": "https://github.com/Xusniddin-devv/scenefile#readme",
  "bugs": {
    "url": "https://github.com/Xusniddin-devv/scenefile/issues"
  }
}
