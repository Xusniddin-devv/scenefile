{
  "name": "scenefile",
  "version": "0.1.0",
  "description": "Turn a JSON scenefile into a professional video. Built for language models.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "scenefile": "./dist/main.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "@scenefile/engine": "workspace:*",
    "@scenefile/mcp": "workspace:*",
    "@scenefile/render": "workspace:*",
    "@scenefile/scenes": "workspace:*",
    "@scenefile/schema": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "video",
    "mp4",
    "llm",
    "agents",
    "mcp",
    "json",
    "ffmpeg",
    "scenefile"
  ],
  "author": "Xusniddin Qalandarov"
}
