{
  "name": "scenefile",
  "version": "0.4.1",
  "description": "Let any coding agent or LLM make videos: a short JSON file becomes an MP4 with narration and captions. MCP server included. Free and local.",
  "mcpName": "io.github.Xusniddin-devv/scenefile",
  "type": "module",
  "license": "MIT",
  "bin": {
    "scenefile": "./dist/main.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "@scenefile/engine": "workspace:*",
    "@scenefile/mcp": "workspace:*",
    "@scenefile/render": "workspace:*",
    "@scenefile/scenes": "workspace:*",
    "@scenefile/schema": "workspace:*"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "video",
    "mp4",
    "llm",
    "agents",
    "mcp",
    "json",
    "ffmpeg",
    "scenefile",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "video-generation",
    "text-to-video",
    "ai-video",
    "narration",
    "captions",
    "screen-recording",
    "remotion-alternative"
  ],
  "author": "Xusniddin Qalandarov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xusniddin-devv/scenefile.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Xusniddin-devv/scenefile#readme",
  "bugs": {
    "url": "https://github.com/Xusniddin-devv/scenefile/issues"
  }
}
