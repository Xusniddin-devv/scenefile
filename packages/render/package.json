{
  "name": "@scenefile/render",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "@scenefile/engine": "workspace:*",
    "@scenefile/runtime": "workspace:*",
    "@scenefile/schema": "workspace:*",
    "playwright-core": "^1.64.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "1.13.8"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "video",
    "mp4",
    "llm",
    "agents",
    "mcp",
    "json",
    "ffmpeg",
    "scenefile"
  ],
  "author": "Xusniddin Qalandarov",
  "publishConfig": {
    "access": "public"
  },
  "description": "Chromium frame capture, ffmpeg encoding and local narration for scenefile."
}
