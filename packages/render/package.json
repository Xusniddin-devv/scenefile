{
  "name": "@scenefile/render",
  "version": "0.3.1",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node ../../scripts/fix-dts.mjs",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "dependencies": {
    "@scenefile/engine": "workspace:*",
    "@scenefile/runtime": "workspace:*",
    "@scenefile/schema": "workspace:*",
    "playwright-core": "^1.64.0"
  },
  "optionalDependencies": {
    "sherpa-onnx-node": "1.13.8"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "video",
    "mp4",
    "llm",
    "agents",
    "mcp",
    "json",
    "ffmpeg",
    "scenefile"
  ],
  "author": "Xusniddin Qalandarov",
  "publishConfig": {
    "access": "public"
  },
  "description": "Chromium frame capture, ffmpeg encoding and local narration for scenefile.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xusniddin-devv/scenefile.git",
    "directory": "packages/render"
  },
  "homepage": "https://github.com/Xusniddin-devv/scenefile#readme",
  "bugs": {
    "url": "https://github.com/Xusniddin-devv/scenefile/issues"
  }
}
